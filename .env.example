# Copy this file to .env.local and fill in your own Supabase project's
# values (Supabase dashboard -> Project Settings -> API).
# .env.local is already gitignored, so it's safe to put real values there.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional QA/testing unlock key. If omitted, the app uses its documented
# fallback test key. This is a browser-side convenience, not a security
# boundary; QA mode blocks competitive/permanent writes by design.
VITE_TD_ADMIN_KEY=replace-with-your-testing-key
